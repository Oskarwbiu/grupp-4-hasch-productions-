    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: even while sprinting...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: these flowers seem to have a connection with you...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: try right clicking on them and maybe you can swing across the gap.
  triggerEventOnEnd: 0
  triggerEvent: 0

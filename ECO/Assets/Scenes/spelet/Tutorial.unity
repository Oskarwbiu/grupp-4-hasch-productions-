    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: seems like your legs are healed...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: Good...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: This gap is a bit too big to jump...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: try pressing SHIFT to sprint...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: maybe you can gain enough momentum to clear the gap.
  triggerEventOnEnd: 0
  triggerEvent: 0

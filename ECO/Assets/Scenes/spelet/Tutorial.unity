    name: Guardian Spirit
    sentences:
    - voice: {fileID: 8300000, guid: ba273f2a01259f94481aa200a09cab56, type: 3}
      sentence: Oh...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: You are finally awake...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: are your legs healed enough to walk...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: try pressing a and d...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: also try to jump over this gap by pressing space.
  triggerEventOnEnd: 0
  triggerEvent: 0

  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 223138524}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e358162b51e2fe47979302573301891, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    icon: {fileID: 21300000, guid: 1c458022588261a4bb484718958587cc, type: 3}
    name: Guardian Spirit
    sentences:
    - voice: {fileID: 8300000, guid: ba273f2a01259f94481aa200a09cab56, type: 3}
      sentence: ahhhh...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: sorry, I thought these were real...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: but they are just training dummies...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: press left click to attack them...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: the one on top might be out of reach...
    - voice: {fileID: 8300000, guid: 2ff808467dd1de44b87a03231abed3fe, type: 3}
      sentence: maybe you can pull it down using your vine...
